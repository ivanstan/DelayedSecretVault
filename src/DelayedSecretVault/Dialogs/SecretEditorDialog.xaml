<Window x:Class="DelayedSecretVault.Dialogs.SecretEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E7EEF2" Offset="0"/>
            <GradientStop Color="#F4F8F7" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <StackPanel Margin="24">
        <DockPanel Margin="0,0,0,16">
            <TextBlock x:Name="TitleIcon"
                       DockPanel.Dock="Left"
                       Text="&#xE192;"
                       FontFamily="{StaticResource IconFont}"
                       FontSize="20"
                       Foreground="{StaticResource AccentBrush}"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="Name" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

        <StackPanel x:Name="SecretSection">
            <TextBlock x:Name="SecretLabel" Text="Secret" Margin="0,0,0,4" Foreground="{StaticResource MutedBrush}"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SecretBox"
                         Grid.Column="0"
                         FontFamily="{StaticResource MonoFont}"
                         VerticalContentAlignment="Center"
                         TextChanged="SecretBox_TextChanged"/>
                <Button Grid.Column="1"
                        Content="Generate"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Padding="12,8"
                        MinHeight="34"
                        Click="Generate_Click"
                        ToolTip="Generate a strong alphanumeric password"/>
            </Grid>
            <TextBlock x:Name="LengthText"
                       Text="0 characters"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,8"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="100" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
