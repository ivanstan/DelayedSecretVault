<Window x:Class="DelayedSecretVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DelayedSecretVault.ViewModels"
        Title="Delayed Secret Vault"
        SizeToContent="Height"
        Width="480"
        MinWidth="420"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        Closing="Window_Closing">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E7EEF2" Offset="0"/>
            <GradientStop Color="#F4F8F7" Offset="0.55"/>
            <GradientStop Color="#EAF3F1" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand + status -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <Border Width="36" Height="36" CornerRadius="8" Background="#D9E8E6" DockPanel.Dock="Left" Margin="0,0,10,0">
                    <TextBlock Text="&#xE72E;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="16"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Delayed Secret Vault"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="One vault. One delay."
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Padding="12,10"
                    CornerRadius="8"
                    Background="#F7FBFC"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1">
                <DockPanel>
                    <TextBlock x:Name="StatusIcon"
                               DockPanel.Dock="Left"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               Foreground="{StaticResource LockedBrush}"
                               Text="&#xE72E;">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                        <Setter Property="Text" Value="&#xE916;"/>
                                        <Setter Property="Foreground" Value="{StaticResource WaitingBrush}"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.45" Duration="0:0:1.1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConfirmation}" Value="True">
                                        <Setter Property="Text" Value="&#xE73E;"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                                        <Setter Property="Text" Value="&#xE785;"/>
                                        <Setter Property="Foreground" Value="{StaticResource UnlockedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                        <Setter Property="Text" Value="&#xE72E;"/>
                                        <Setter Property="Foreground" Value="{StaticResource LockedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="{Binding RemainingText}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RemainingText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- Locked -->
            <StackPanel Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FadeInPanel}">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE192;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding SecretCount, Mode=OneWay}"/>
                        <Run Text=" stored secrets"/>
                    </TextBlock>
                </DockPanel>

                <DockPanel Margin="0,0,0,14">
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE121;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,1,8,0"/>
                    <TextBlock Text="{Binding AccessDelayDescription}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               LineHeight="18"/>
                </DockPanel>

                <Button Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        Click="RequestAccess_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FB;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Request vault access" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Waiting -->
            <StackPanel Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FadeInPanel}">
                <TextBlock Text="Sit with the delay. Closing the app resets the wait."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>
                <Button Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="CancelRequest_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cancel request" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Confirmation -->
            <StackPanel Visibility="{Binding IsConfirmation, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource FadeInPanel}">
                <TextBlock Text="Waiting period completed."
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Do you still need access?"
                           FontSize="13"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,0,14"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="ConfirmUnlock_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Unlock vault" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}"
                            Click="CancelConfirmation_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Unlocked -->
            <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}"
                  Style="{StaticResource FadeInPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Action toolbar -->
                <Border Grid.Row="0"
                        Background="#EEF3F5"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6"
                        Margin="0,0,0,10">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Button Style="{StaticResource ToolButton}" Click="Reveal_Click" ToolTip="Reveal selected secret">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE890;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Reveal" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Copy_Click" ToolTip="Copy selected secret">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Copy" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Add_Click" ToolTip="Add secret">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Add" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Rename_Click" ToolTip="Rename selected secret">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AC;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Rename" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Click="Replace_Click" ToolTip="Replace secret value">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Replace" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource ToolDangerButton}"
                                DockPanel.Dock="Right"
                                Click="Delete_Click"
                                ToolTip="Delete selected secret">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Secrets}"
                         SelectedItem="{Binding SelectedSecret}"
                         BorderBrush="{StaticResource LineBrush}"
                         BorderThickness="1"
                         Background="#F7FBFC"
                         Height="220"
                         Margin="0,0,0,10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#DCEDEA"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E8F2F1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SecretListItem}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="&#xE8D7;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding RevealedValue}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Margin="20,4,0,0"
                                           Foreground="{StaticResource InkBrush}"
                                           Visibility="{Binding IsRevealed, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Click="LockNow_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Lock now" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
